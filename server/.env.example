# Copy this file to .env inside server/ and paste your Atlas connection string.
# Replace the username, URL-encoded password and cluster hostname.
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/fundtogether?retryWrites=true&w=majority
MONGODB_URI=
# Database tools require an explicit target. Use a separate database for tests.
MONGODB_DATABASE=fundtogether
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Private document directory, relative to the server working directory.
UPLOAD_DIR=storage
# Set both before running the demo seed. Use different passwords.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
STARTER_CREDIT=100000
